<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Suppressions layered on top of the checkstyle jar's google_checks.xml, wired in by
  JavaConventionsPlugin via the ${org.checkstyle.google.suppressionfilter.config} property.

  google_checks requires a Javadoc comment on every public/protected type and method. That is
  heavier than these conventions want, so those two checks are switched off. Every other check,
  including Javadoc *formatting* (SummaryJavadoc, JavadocParagraph, ...), stays enforced.

  AbbreviationAsWordInName is also off: google_checks caps consecutive capitals in an identifier
  (e.g. flags `IOException`-style names, `parseHTTPUrl`, `getURL`), which is more restrictive than we
  want for common acronyms.

  Unnamed variables (JEP 456, `_`) are idiomatic in modern Java — unbound pattern-match arms
  (`case Foo _ ->`) and ignored lambda parameters (`_ -> ...`). google_checks' name checks predate
  them and reject `_` as a malformed identifier, so drop only the `_` case (matched by message);
  every other pattern-variable / lambda-parameter name stays enforced.

  Test sources lean on two conventions google_checks rejects: on-demand (star) imports — especially
  static `org.junit.jupiter.api.Assertions.*` — and underscore-segmented method names that read as
  given_when_then (e.g. `testReader_ValueAtOffset_LE`). Both are allowed in test source only (matched
  by path); main code still has its imports and method names enforced.
-->
<suppressions>
  <suppress checks="MissingJavadocType" files=".*"/>
  <suppress checks="MissingJavadocMethod" files=".*"/>
  <suppress checks="AbbreviationAsWordInName" files=".*"/>

  <suppress checks="PatternVariableName" message="'_' must match"/>
  <suppress checks="LambdaParameterName" message="'_' must match"/>

  <suppress checks="AvoidStarImport" files="[/\\]src[/\\]test[/\\]"/>
  <suppress checks="MethodName" files="[/\\]src[/\\]test[/\\]"/>
</suppressions>
